# ─────────────────────────────────────────────────────────────
#  Reporta Bache · Ciudad Obregón — variables de entorno
#  Copia este archivo como .env.local y llena los valores.
# ─────────────────────────────────────────────────────────────

# URL pública de la app (se usa en el correo y en el QR del comprobante)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Ciudad y mapa ───────────────────────────────────────────
NEXT_PUBLIC_CITY_NAME="Ciudad Obregón, Sonora"
NEXT_PUBLIC_MAP_CENTER_LAT=27.4833
NEXT_PUBLIC_MAP_CENTER_LNG=-109.9333
NEXT_PUBLIC_MAP_ZOOM=13
# Se rechazan reportes a más de esta distancia del centro (km)
NEXT_PUBLIC_REPORT_MAX_DISTANCE_KM=40

# ── Supabase ────────────────────────────────────────────────
# Si se dejan vacías, la app funciona en "modo de prueba" y guarda
# los reportes en la carpeta .data/ de tu computadora.
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública (anon o "publishable key"): solo lectura del mapa
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave secreta (service_role o "secret key"): ¡nunca la publiques!
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=fotos-baches

# ── Destinatario de los reportes ───────────────────────────
# Mientras pruebas, pon TU correo aquí para no enviar reportes falsos al municipio.
AUTHORITY_EMAIL=atencionciudadana@cajeme.gob.mx
AUTHORITY_NAME="Atención Ciudadana del H. Ayuntamiento de Cajeme"
# Copia opcional (separa varios correos con comas)
AUTHORITY_EMAIL_CC=

# ── Envío de correo ─────────────────────────────────────────
# Interruptor general: pon "true" cuando quieras que los correos salgan de verdad.
EMAIL_SEND_ENABLED=false
# Remitente. Con Resend debe ser de un dominio verificado en tu cuenta.
EMAIL_FROM="Reporta Bache Obregón <reportes@tudominio.com>"
EMAIL_REPLY_TO=

# Opción A — Resend (recomendado): pega aquí tu API key
RESEND_API_KEY=

# Opción B — SMTP con Nodemailer (se usa solo si no hay RESEND_API_KEY)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── Opcionales ──────────────────────────────────────────────
# Con esta clave, Street View se muestra dentro de la app en lugar de abrir Google Maps.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Correo de contacto para el servicio gratuito de direcciones (OpenStreetMap Nominatim)
NOMINATIM_CONTACT_EMAIL=
